[Unit]
Description=Daybagger Paper Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/daybagger
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/daybagger/.venv/bin/python scripts/run_paper_runtime.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
