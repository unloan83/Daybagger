# The OCI Usage API reports costs in the tenancy's billing currency.
THRESHOLD_AMOUNT=0.01
EXPECTED_CURRENCY=USD

# Keep false until --preflight returns PREFLIGHT_OK and the returned currency
# has been checked. Enabling this without IAM access will lock research jobs.
ENFORCEMENT_ENABLED=false

# A detected positive cost locks research workloads and requests a VM stop.
STOP_INSTANCE_ON_BREACH=true

# Losing billing visibility locks research workloads. It does not stop the VM
# by default because transient OCI API failures must not create restart loops.
FAIL_CLOSED_ON_API_ERROR=true
STOP_INSTANCE_ON_API_ERROR=false

# OCI permits at most 36 hours for an hourly Usage API query.
LOOKBACK_HOURS=36
STATE_DIR=/var/lib/daybagger-billing-guard
WORKLOAD_UNITS=daybagger-research.slice
